# Public site URL — required for correct sitemap/robots on Vercel subdomain.
# Use your Vercel URL until nooraccessrental.com is connected:
NEXT_PUBLIC_SITE_URL=https://nooraccessrental.vercel.app

# After connecting custom domain, change to:
# NEXT_PUBLIC_SITE_URL=https://nooraccessrental.com
# NEXT_PUBLIC_CANONICAL_URL=https://nooraccessrental.com

# Google Search Console — HTML tag method (recommended for Next.js; no root HTML file).
# 1. Search Console → property → Verify → "HTML tag"
# 2. Copy the content= value (not the filename) and paste below
# 3. Add the same variable in Vercel → Project → Settings → Environment Variables
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google03d827e6ef9ca398
